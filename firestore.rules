rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAnon() { return signedIn() && request.auth.token.firebase.sign_in_provider == "anonymous"; }
    function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isAdmin() { return signedIn() && !isAnon() && role() == "admin"; }
    function isStaff() { return signedIn() && !isAnon() && role() in ["admin", "supervisor"]; }
    function validVisit() {
      let d = request.resource.data;
      return d.createdBy == request.auth.uid
        && d.info.center is string && d.info.center.size() > 0 && d.info.center.size() < 200
        && d.info.municipality is string && d.info.municipality.size() > 0 && d.info.municipality.size() < 200
        && d.answers is map;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // قائمة البلديات والمراكز: يقرؤها تطبيق الهاتف (ولو بدون حساب)، وتعدّلها الإدارة فقط
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /visits/{visitId} {
      allow create: if (isAnon() || isStaff()) && validVisit();
      allow read: if isStaff();
      allow update, delete: if isAdmin();
    }
  }
}
